{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "linkversity": {
      "type": "streamable-http",
      "url": "https://linkversity.lol/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorization_url": "https://linkversity.lol/oauth/authorize",
            "token_url": "https://linkversity.lol/oauth/token",
            "scope": "collections:read",
            "pkce_method": "S256"
          }
        }
      }
    }
  }
}
