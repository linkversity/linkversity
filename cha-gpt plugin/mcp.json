{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "linkversity": {
      "type": "streamable-http",
      "url": "https://linkversity.lol/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["collections:read", "collections:write"]
          }
        }
      }
    }
  }
}
