{
  "manifest_version": 3,
  "name": "Linkversity Saver",
  "version": "1.2.0",
  "description": "Save links to your Linkversity paths instantly.",
  "permissions": [
    "activeTab",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://linkversity.lol/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Save this page to Linkversity"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}
